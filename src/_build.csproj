<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <RunWorkingDirectory>$(MSBuildProjectDirectory)</RunWorkingDirectory>
    <OutputPath>..\bin</OutputPath>
	<Nullable>Enable</Nullable>
    <NoWarn>CS0649;CS0169</NoWarn>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Cake.Frosting" Version="7.0.0" />
    <PackageReference Include="Cake.Git" Version="5.0.1" />
    <PackageReference Include="Cake.Npm" Version="5.1.0" />
    <PackageReference Include="Microsoft.Build" Version="18.12.2" />
    <PackageReference Include="NuGet.Packaging" Version="8.0.0" />
    <PackageReference Include="NuGet.Protocol" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageDownload Include="GitVersion.Tool" Version="[5.12.0]" />
    <PackageDownload Include="npm" Version="[3.5.2]" />
  </ItemGroup>

</Project>
